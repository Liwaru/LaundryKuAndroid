<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cashierCustomerDetailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/owner_background">

    <LinearLayout
        android:id="@+id/cashierCustomerDetailHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/cashierCustomerDetailBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_back_description"
            android:padding="12dp"
            android:src="@drawable/ic_back" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/cashier_customer_detail_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cashierCustomerDetailContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierCustomerDetailHeader">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <TextView style="@style/ProfileInfoLabel" android:text="@string/profile_name_label" />
                    <TextView android:id="@+id/cashierCustomerDetailName" style="@style/ProfileInfoValue" />
                    <TextView style="@style/ProfileInfoLabel" android:layout_marginTop="14dp" android:text="@string/profile_username_label" />
                    <TextView android:id="@+id/cashierCustomerDetailUsername" style="@style/ProfileInfoValue" />
                    <TextView style="@style/ProfileInfoLabel" android:layout_marginTop="14dp" android:text="@string/profile_phone_label" />
                    <TextView android:id="@+id/cashierCustomerDetailPhone" style="@style/ProfileInfoValue" />
                    <TextView style="@style/ProfileInfoLabel" android:layout_marginTop="14dp" android:text="@string/management_account_status" />
                    <TextView android:id="@+id/cashierCustomerDetailStatus" style="@style/ProfileInfoValue" />
                    <TextView style="@style/ProfileInfoLabel" android:layout_marginTop="14dp" android:text="@string/management_total_transactions" />
                    <TextView android:id="@+id/cashierCustomerDetailTotal" style="@style/ProfileInfoValue" />
                    <TextView style="@style/ProfileInfoLabel" android:layout_marginTop="14dp" android:text="@string/management_total_spending" />
                    <TextView android:id="@+id/cashierCustomerDetailSpending" style="@style/ProfileInfoValue" />
                    <TextView style="@style/ProfileInfoLabel" android:layout_marginTop="14dp" android:text="@string/management_joined_at" />
                    <TextView android:id="@+id/cashierCustomerDetailCreated" style="@style/ProfileInfoValue" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="24dp"
                android:text="@string/cashier_customer_recent_title" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cashierCustomerRecentCard"
                style="@style/ProfileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:id="@+id/cashierCustomerRecentList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </com.google.android.material.card.MaterialCardView>
            <TextView
                android:id="@+id/cashierCustomerRecentEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/cashier_customer_recent_empty"
                android:textColor="@color/laundry_text_secondary"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/cashierCustomerDetailLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierCustomerDetailHeader" />

    <LinearLayout
        android:id="@+id/cashierCustomerDetailError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierCustomerDetailHeader">
        <TextView
            android:id="@+id/cashierCustomerDetailErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cashier_customer_detail_error"
            android:textColor="@color/laundry_text_primary" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/cashierCustomerDetailRetry"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/cashier_dashboard_retry"
            android:textAllCaps="false" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
