<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ownerStaffRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/owner_background"
    tools:context=".OwnerStaffActivity">

    <LinearLayout
        android:id="@+id/ownerStaffHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_dashboard_brand_logo"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/laundry_logo_description"
                    android:src="@drawable/ic_laundry_white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/laundry_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/owner_staff_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ownerStaffScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/ownerStaffBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ownerStaffHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/OwnerStaffSummaryCard"
                    android:layout_marginEnd="5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="@string/owner_staff_summary_cashier" android:src="@drawable/ic_owner_customer_data" app:tint="@color/laundry_primary" />
                        <TextView android:id="@+id/ownerStaffCashierCount" style="@style/OwnerStaffSummaryValue" android:layout_marginTop="4dp" />
                        <TextView style="@style/OwnerStaffSummaryLabel" android:text="@string/owner_staff_summary_cashier" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OwnerStaffSummaryCard"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="@string/owner_staff_summary_laundry" android:src="@drawable/ic_owner_staff" app:tint="@color/order_packing" />
                        <TextView android:id="@+id/ownerStaffLaundryCount" style="@style/OwnerStaffSummaryValue" android:layout_marginTop="4dp" />
                        <TextView style="@style/OwnerStaffSummaryLabel" android:text="@string/owner_staff_summary_laundry" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/OwnerStaffSummaryCard"
                    android:layout_marginStart="5dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                        <ImageView android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="@string/owner_staff_summary_active" android:src="@drawable/ic_owner_check" app:tint="@color/dashboard_success" />
                        <TextView android:id="@+id/ownerStaffActiveCount" style="@style/OwnerStaffSummaryValue" android:layout_marginTop="4dp" />
                        <TextView style="@style/OwnerStaffSummaryLabel" android:text="@string/owner_staff_summary_active" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ownerStaffAddButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:text="@string/owner_staff_add"
                android:textAllCaps="false"
                android:textColor="@color/laundry_on_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/laundry_primary"
                app:cornerRadius="14dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:boxBackgroundColor="@color/laundry_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/dashboard_divider"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/laundry_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ownerStaffSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/owner_staff_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/laundry_text_primary"
                    android:textColorHint="@color/laundry_text_hint"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_order_filter_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">
                <TextView android:id="@+id/ownerStaffFilterAll" style="@style/CustomerOrderFilterTab.Active" android:text="@string/owner_staff_filter_all" />
                <TextView android:id="@+id/ownerStaffFilterCashier" style="@style/CustomerOrderFilterTab" android:text="@string/owner_staff_filter_cashier" />
                <TextView android:id="@+id/ownerStaffFilterLaundry" style="@style/CustomerOrderFilterTab" android:text="@string/owner_staff_filter_laundry" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ownerStaffList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/ownerStaffEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/ownerStaffEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/owner_staff_empty_title"
                    android:textColor="@color/laundry_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ownerStaffEmptyDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/owner_staff_empty_description"
                    android:textColor="@color/laundry_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/ownerStaffLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/ownerStaffBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ownerStaffHeader" />

    <LinearLayout
        android:id="@+id/ownerStaffErrorState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ownerStaffBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ownerStaffHeader">

        <TextView
            android:id="@+id/ownerStaffErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/owner_staff_load_error"
            android:textColor="@color/laundry_text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ownerStaffRetryButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/owner_staff_retry"
            android:textAllCaps="false"
            android:textColor="@color/laundry_primary"
            app:strokeColor="@color/laundry_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ownerStaffBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/ownerStaffNavHome" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" app:srcCompat="@drawable/ic_home" app:tint="@color/dashboard_nav_inactive" /><TextView style="@style/DashboardNavLabel" android:text="@string/nav_home" /></LinearLayout>
        <LinearLayout android:id="@+id/ownerStaffNavReports" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/owner_nav_reports" app:srcCompat="@drawable/ic_owner_chart" app:tint="@color/dashboard_nav_inactive" /><TextView style="@style/DashboardNavLabel" android:text="@string/owner_nav_reports" /></LinearLayout>
        <LinearLayout android:id="@+id/ownerStaffNavStaff" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/owner_nav_staff" app:srcCompat="@drawable/ic_owner_staff" app:tint="@color/laundry_primary" /><TextView style="@style/DashboardNavLabel.Active" android:text="@string/owner_nav_staff" /></LinearLayout>
        <LinearLayout android:id="@+id/ownerStaffNavProfile" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" app:srcCompat="@drawable/ic_profile_nav" app:tint="@color/dashboard_nav_inactive" /><TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" /></LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
