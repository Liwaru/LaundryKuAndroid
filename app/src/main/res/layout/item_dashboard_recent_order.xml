<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dashboardRecentOrderCode"
            style="@style/DashboardOrderCode"
            tools:text="#LDY-20260827-001" />

        <TextView
            android:id="@+id/dashboardRecentOrderDetail"
            style="@style/DashboardOrderDetail"
            tools:text="Cuci Setrika • 27 Agustus 2026" />
    </LinearLayout>

    <TextView
        android:id="@+id/dashboardRecentOrderStatus"
        style="@style/DashboardDoneBadge"
        tools:text="Selesai" />
</LinearLayout>
