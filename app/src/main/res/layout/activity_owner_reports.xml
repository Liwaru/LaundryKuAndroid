<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ownerReportsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/owner_background"
    tools:context=".OwnerReportsActivity">

    <LinearLayout
        android:id="@+id/ownerReportsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_dashboard_brand_logo" android:padding="8dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/laundry_logo_description" android:src="@drawable/ic_laundry_white" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" android:text="@string/app_name" android:textColor="@color/laundry_text_primary" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/owner_reports_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/ownerReportsBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ownerReportsHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_order_filter_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">
                <TextView style="@style/CustomerOrderFilterTab.Active" android:text="@string/owner_reports_period_today" />
                <TextView style="@style/CustomerOrderFilterTab" android:text="@string/owner_reports_period_week" />
                <TextView style="@style/CustomerOrderFilterTab" android:text="@string/owner_reports_period_month" />
            </LinearLayout>

            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/owner_reports_summary" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:baselineAligned="false" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView style="@style/OwnerSummaryCard" android:layout_marginEnd="6dp">
                    <LinearLayout style="@style/OwnerSummaryContent">
                        <FrameLayout style="@style/OwnerIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/owner_reports_revenue" android:src="@drawable/ic_owner_wallet" />
                        </FrameLayout>
                        <TextView style="@style/OwnerSummaryValue" android:text="@string/owner_reports_revenue_value" />
                        <TextView style="@style/OwnerSummaryLabel" android:text="@string/owner_reports_revenue" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/OwnerSummaryCard" android:layout_marginStart="6dp">
                    <LinearLayout style="@style/OwnerSummaryContent">
                        <FrameLayout style="@style/OwnerIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/owner_reports_total_transactions" android:src="@drawable/ic_owner_receipt" />
                        </FrameLayout>
                        <TextView style="@style/OwnerSummaryValue" android:text="@string/owner_reports_total_transactions_value" />
                        <TextView style="@style/OwnerSummaryLabel" android:text="@string/owner_reports_total_transactions" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:baselineAligned="false" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView style="@style/OwnerSummaryCard" android:layout_marginEnd="6dp">
                    <LinearLayout style="@style/OwnerSummaryContent">
                        <FrameLayout style="@style/OwnerIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/owner_reports_completed" android:src="@drawable/ic_owner_check" />
                        </FrameLayout>
                        <TextView style="@style/OwnerSummaryValue" android:text="@string/owner_reports_completed_value" />
                        <TextView style="@style/OwnerSummaryLabel" android:text="@string/owner_reports_completed" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView style="@style/OwnerSummaryCard" android:layout_marginStart="6dp">
                    <LinearLayout style="@style/OwnerSummaryContent">
                        <FrameLayout style="@style/OwnerIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/owner_reports_cancelled" android:src="@drawable/ic_owner_cancel" />
                        </FrameLayout>
                        <TextView style="@style/OwnerSummaryValue" android:text="@string/owner_reports_cancelled_value" />
                        <TextView style="@style/OwnerSummaryLabel" android:text="@string/owner_reports_cancelled" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginTop="26dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout style="@style/CashierQuickIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/owner_reports_financial_title" android:src="@drawable/ic_owner_wallet" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="sans-serif-medium" android:text="@string/owner_reports_financial_title" android:textColor="@color/laundry_text_primary" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <TextView style="@style/CustomerOrderInfoLabel" android:layout_marginTop="16dp" android:text="@string/owner_reports_income_label" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:text="@string/owner_reports_income_value" android:textColor="@color/laundry_text_primary" android:textSize="22sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/owner_reports_successful_payments" android:textColor="@color/laundry_text_secondary" android:textSize="13sp" />
                    <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp" android:text="@string/detail_order" android:textAllCaps="false" android:textColor="@color/laundry_primary" android:textSize="13sp" app:cornerRadius="12dp" app:strokeColor="@color/laundry_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout style="@style/CashierQuickIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/owner_reports_transaction_title" android:src="@drawable/ic_owner_transaction_report" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:fontFamily="sans-serif-medium" android:text="@string/owner_reports_transaction_title" android:textColor="@color/laundry_text_primary" android:textSize="18sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_owner_count" android:gravity="center" android:text="@string/owner_reports_transaction_total" android:textColor="@color/laundry_primary_dark" android:textSize="13sp" />
                        <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_status_done" android:gravity="center" android:text="@string/owner_reports_transaction_completed" android:textColor="@color/dashboard_success" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:background="@drawable/bg_order_status_washing" android:gravity="center" android:text="@string/owner_reports_transaction_active" android:textColor="@color/laundry_primary_dark" android:textSize="13sp" />
                        <TextView android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="5dp" android:layout_weight="1" android:background="@drawable/bg_history_cancelled" android:gravity="center" android:text="@string/owner_reports_transaction_cancelled" android:textColor="@color/history_cancelled" android:textSize="13sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="16dp" android:text="@string/detail_order" android:textAllCaps="false" android:textColor="@color/laundry_primary" android:textSize="13sp" app:cornerRadius="12dp" app:strokeColor="@color/laundry_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/owner_reports_best_services" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView style="@style/OwnerRankNumber" android:text="@string/owner_rank_one" /><TextView style="@style/OwnerListLabel" android:layout_marginStart="12dp" android:text="@string/service_iron" /><TextView style="@style/OwnerOperationalCount" android:text="@string/owner_reports_service_iron_count" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView style="@style/OwnerRankNumber" android:text="@string/owner_rank_two" /><TextView style="@style/OwnerListLabel" android:layout_marginStart="12dp" android:text="@string/service_dry" /><TextView style="@style/OwnerOperationalCount" android:text="@string/owner_reports_service_dry_count" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView style="@style/OwnerRankNumber" android:text="@string/owner_rank_three" /><TextView style="@style/OwnerListLabel" android:layout_marginStart="12dp" android:text="@string/service_express" /><TextView style="@style/OwnerOperationalCount" android:text="@string/owner_reports_service_express_count" /></LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView style="@style/OwnerRankNumber" android:text="@string/owner_rank_four" /><TextView style="@style/OwnerListLabel" android:layout_marginStart="12dp" android:text="@string/service_bed_cover" /><TextView style="@style/OwnerOperationalCount" android:text="@string/owner_reports_service_bedcover_count" /></LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ownerReportsBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/ownerReportsNavHome" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" app:srcCompat="@drawable/ic_home" app:tint="@color/dashboard_nav_inactive" /><TextView style="@style/DashboardNavLabel" android:text="@string/nav_home" /></LinearLayout>
        <LinearLayout android:id="@+id/ownerReportsNavReports" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/owner_nav_reports" app:srcCompat="@drawable/ic_owner_chart" app:tint="@color/laundry_primary" /><TextView style="@style/DashboardNavLabel.Active" android:text="@string/owner_nav_reports" /></LinearLayout>
        <LinearLayout android:id="@+id/ownerReportsNavStaff" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/owner_nav_staff" app:srcCompat="@drawable/ic_owner_staff" app:tint="@color/dashboard_nav_inactive" /><TextView style="@style/DashboardNavLabel" android:text="@string/owner_nav_staff" /></LinearLayout>
        <LinearLayout android:id="@+id/ownerReportsNavProfile" style="@style/DashboardNavItem"><ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" app:srcCompat="@drawable/ic_profile_nav" /><TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" /></LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
