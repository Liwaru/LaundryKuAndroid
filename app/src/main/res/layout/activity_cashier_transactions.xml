<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cashierTransactionsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".CashierTransactionActivity">

    <LinearLayout
        android:id="@+id/cashierTransactionsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_dashboard_brand_logo"
                android:padding="8dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/laundry_logo_description" android:src="@drawable/ic_laundry_white" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" android:text="@string/app_name" android:textColor="@color/laundry_text_primary" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/cashier_transactions_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cashierTransactionsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/cashierTransactionsBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierTransactionsHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cashierNewTransactionButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cashier_new_transaction"
                android:textAllCaps="false"
                android:textColor="@color/laundry_on_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/laundry_primary"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:boxBackgroundColor="@color/laundry_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/laundry_outline"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/laundry_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/cashierTransactionsSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="@string/cashier_transaction_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/laundry_text_primary"
                    android:textColorHint="@color/laundry_text_hint"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_order_filter_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">
                <TextView android:id="@+id/cashierTransactionsFilterAll" style="@style/CustomerOrderFilterTab.Active" android:text="@string/cashier_filter_all" />
                <TextView android:id="@+id/cashierTransactionsFilterUnpaid" style="@style/CustomerOrderFilterTab" android:text="@string/cashier_filter_unpaid" android:textSize="12sp" />
                <TextView android:id="@+id/cashierTransactionsFilterPaid" style="@style/CustomerOrderFilterTab" android:text="@string/cashier_filter_paid" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_order_filter_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">
                <TextView android:id="@+id/cashierTransactionsFilterReady" style="@style/CustomerOrderFilterTab" android:text="@string/cashier_filter_ready" />
                <TextView android:id="@+id/cashierTransactionsFilterCompleted" style="@style/CustomerOrderFilterTab" android:text="@string/cashier_filter_completed" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/cashierTransactionsLoading"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:indeterminateTint="@color/laundry_primary" />

            <LinearLayout
                android:id="@+id/cashierTransactionsErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cashier_transactions_load_error"
                    android:textColor="@color/laundry_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cashierTransactionsRetryButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/create_order_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/laundry_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cashierTransactionsEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/cashierTransactionsEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/cashier_transactions_empty_title"
                    android:textColor="@color/laundry_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cashierTransactionsEmptyDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/cashier_transactions_empty_description"
                    android:textColor="@color/laundry_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cashierTransactionsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/cashierTransactionsBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/cashierTransactionsNavHome" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" app:srcCompat="@drawable/ic_home" app:tint="@color/dashboard_nav_inactive" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_home" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cashierTransactionsNavTransactions" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/cashier_nav_transactions" app:srcCompat="@drawable/ic_orders" app:tint="@color/laundry_primary" />
            <TextView style="@style/DashboardNavLabel.Active" android:text="@string/cashier_nav_transactions" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cashierTransactionsNavCustomers" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/cashier_nav_customers" app:srcCompat="@drawable/ic_owner_customer_data" app:tint="@color/dashboard_nav_inactive" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/cashier_nav_customers" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cashierTransactionsNavProfile"
            style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" app:srcCompat="@drawable/ic_profile_nav" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
