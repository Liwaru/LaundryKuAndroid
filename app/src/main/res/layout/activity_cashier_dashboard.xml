<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cashierDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".CashierDashboardActivity">

    <LinearLayout
        android:id="@+id/cashierDashboardHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dashboard_brand_logo"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/laundry_logo_description"
                    android:src="@drawable/ic_laundry_white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/laundry_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cashierGreetingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cashier_greeting"
                android:textColor="@color/laundry_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dashboard_profile"
                android:padding="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_description"
                    android:src="@drawable/ic_person" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/cashierDashboardScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/cashierBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierDashboardHeader">

        <LinearLayout
            android:id="@+id/cashierDashboardContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView style="@style/DashboardSectionTitle" android:text="@string/cashier_summary_today" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/StaffSummaryCard"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/staff_blue_soft">
                    <LinearLayout style="@style/StaffSummaryContent">
                        <TextView android:id="@+id/cashierCountActive" style="@style/StaffSummaryCount" tools:text="8" />
                        <TextView style="@style/StaffSummaryLabel" android:text="@string/cashier_incoming_orders" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/StaffSummaryCard"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/dashboard_warning_soft">
                    <LinearLayout style="@style/StaffSummaryContent">
                        <TextView android:id="@+id/cashierCountUnpaid" style="@style/StaffSummaryCount" tools:text="3" />
                        <TextView style="@style/StaffSummaryLabel" android:text="@string/cashier_unpaid" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/StaffSummaryCard"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="@color/staff_cyan_soft">
                    <LinearLayout style="@style/StaffSummaryContent">
                        <TextView android:id="@+id/cashierCountReady" style="@style/StaffSummaryCount" tools:text="2" />
                        <TextView style="@style/StaffSummaryLabel" android:text="@string/cashier_ready_pickup" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/StaffSummaryCard"
                    android:layout_marginStart="6dp"
                    app:cardBackgroundColor="@color/dashboard_success_soft">
                    <LinearLayout style="@style/StaffSummaryContent">
                        <TextView android:id="@+id/cashierIncomeToday" style="@style/StaffSummaryCount" android:textSize="18sp" tools:text="Rp125.000" />
                        <TextView style="@style/StaffSummaryLabel" android:text="@string/cashier_income_today" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/cashier_quick_actions" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cashierCreateTransactionButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/cashier_create_transaction_cta"
                android:textAllCaps="false"
                android:textColor="@color/laundry_on_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/laundry_primary"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/CashierQuickCard"
                    android:layout_marginEnd="4dp">
                    <LinearLayout style="@style/CashierQuickContent">
                        <FrameLayout style="@style/CashierQuickIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/cashier_customer_data" android:src="@drawable/ic_person" />
                        </FrameLayout>
                        <TextView style="@style/CashierQuickLabel" android:text="@string/cashier_customer_data" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/CashierQuickCard"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp">
                    <LinearLayout style="@style/CashierQuickContent">
                        <FrameLayout style="@style/CashierQuickIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/cashier_service_data" android:src="@drawable/ic_service_data" />
                        </FrameLayout>
                        <TextView style="@style/CashierQuickLabel" android:text="@string/cashier_service_data" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/CashierQuickCard"
                    android:layout_marginStart="4dp">
                    <LinearLayout style="@style/CashierQuickContent">
                        <FrameLayout style="@style/CashierQuickIconBackground">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/cashier_payment" android:src="@drawable/ic_payment" />
                        </FrameLayout>
                        <TextView style="@style/CashierQuickLabel" android:text="@string/cashier_payment" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView style="@style/DashboardSectionTitle" android:layout_width="0dp" android:layout_weight="1" android:text="@string/cashier_latest_transactions" />
                <TextView android:id="@+id/cashierSeeAllTransactions" android:layout_width="wrap_content" android:layout_height="48dp" android:fontFamily="sans-serif-medium" android:gravity="center" android:text="@string/see_all" android:textColor="@color/laundry_primary" android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cashierRecentTransactionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/laundry_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dashboard_divider"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout
                        android:id="@+id/cashierRecentTransactionsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <LinearLayout
                        android:id="@+id/cashierRecentTransactionsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp"
                        android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/cashier_dashboard_empty_title" android:textColor="@color/laundry_text_primary" android:textSize="15sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/cashier_dashboard_empty_description" android:textColor="@color/laundry_text_secondary" android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/cashierReadyOrdersTitle"
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/cashier_ready_orders" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cashierReadyOrdersCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/laundry_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dashboard_divider"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:id="@+id/cashierReadyOrdersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/cashierDashboardLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@id/cashierBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierDashboardHeader" />

    <LinearLayout
        android:id="@+id/cashierDashboardErrorState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cashierBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cashierDashboardHeader">
        <TextView android:id="@+id/cashierDashboardErrorMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/cashier_dashboard_load_error" android:textColor="@color/laundry_text_primary" android:textSize="16sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/cashierDashboardRetryButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/cashier_dashboard_retry" android:textAllCaps="false" android:textColor="@color/laundry_primary" app:strokeColor="@color/laundry_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cashierBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/cashierNavHome" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" android:src="@drawable/ic_home" />
            <TextView style="@style/DashboardNavLabel.Active" android:text="@string/nav_home" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cashierNavTransactions" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/cashier_nav_transactions" android:src="@drawable/ic_orders" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/cashier_nav_transactions" />
        </LinearLayout>
        <LinearLayout android:id="@+id/cashierNavCustomers" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/cashier_nav_customers" android:src="@drawable/ic_profile_nav" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/cashier_nav_customers" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/cashierNavProfile"
            style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" android:src="@drawable/ic_profile_nav" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
