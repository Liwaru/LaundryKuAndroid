<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ProfileCard"
    android:layout_marginTop="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/staffHistoryCode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/laundry_text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/staffHistoryCustomer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="sans-serif-medium" android:textColor="@color/laundry_text_primary" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:id="@+id/staffHistoryStatus" style="@style/CustomerOrderStatusBadge" />
        </LinearLayout>
        <TextView android:id="@+id/staffHistoryDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:textColor="@color/laundry_text_secondary" android:textSize="14sp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@color/dashboard_divider" />
        <TextView style="@style/CustomerOrderInfoLabel" android:layout_marginTop="13dp" android:text="@string/staff_history_last_update" />
        <TextView android:id="@+id/staffHistoryDate" style="@style/CustomerOrderInfoValue" />
        <com.google.android.material.button.MaterialButton android:id="@+id/staffHistoryDetailButton" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="15dp" android:text="@string/detail_order" android:textAllCaps="false" android:textColor="@color/laundry_primary" android:textSize="13sp" app:cornerRadius="12dp" app:strokeColor="@color/laundry_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
