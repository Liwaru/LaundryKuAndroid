<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/staffJobsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".StaffJobsActivity">

    <LinearLayout
        android:id="@+id/staffJobsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_dashboard_brand_logo" android:padding="8dp">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/laundry_logo_description" android:src="@drawable/ic_laundry_white" />
            </FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" android:text="@string/app_name" android:textColor="@color/laundry_text_primary" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/staff_jobs_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/staffJobsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/staffJobsBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/staffJobsHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="18dp"
            android:paddingBottom="30dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:boxBackgroundColor="@color/laundry_surface"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/laundry_outline"
                app:boxStrokeWidth="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/laundry_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/staffJobsSearchInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:hint="@string/staff_jobs_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/laundry_text_primary"
                    android:textColorHint="@color/laundry_text_hint"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="never"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/staffJobsFilterAll" style="@style/StaffJobsFilterChip.Active" android:text="@string/staff_jobs_filter_all" />
                    <TextView android:id="@+id/staffJobsFilterWaiting" style="@style/StaffJobsFilterChip" android:layout_marginStart="8dp" android:text="@string/staff_jobs_filter_waiting" />
                    <TextView android:id="@+id/staffJobsFilterWashing" style="@style/StaffJobsFilterChip" android:layout_marginStart="8dp" android:text="@string/staff_jobs_filter_washing" />
                    <TextView android:id="@+id/staffJobsFilterDrying" style="@style/StaffJobsFilterChip" android:layout_marginStart="8dp" android:text="@string/staff_jobs_filter_drying" />
                    <TextView android:id="@+id/staffJobsFilterIroning" style="@style/StaffJobsFilterChip" android:layout_marginStart="8dp" android:text="@string/staff_jobs_filter_ironing" />
                    <TextView android:id="@+id/staffJobsFilterPacking" style="@style/StaffJobsFilterChip" android:layout_marginStart="8dp" android:text="@string/staff_jobs_filter_packing" />
                    <TextView android:id="@+id/staffJobsFilterReady" style="@style/StaffJobsFilterChip" android:layout_marginStart="8dp" android:text="@string/staff_jobs_filter_ready" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ProgressBar android:id="@+id/staffJobsLoading" android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center_horizontal" android:layout_marginTop="28dp" android:indeterminateTint="@color/laundry_primary" />

                <LinearLayout android:id="@+id/staffJobsErrorState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center" android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/staff_jobs_load_error" android:textColor="@color/laundry_text_secondary" android:textSize="14sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/staffJobsRetryButton" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="@string/create_order_retry" android:textAllCaps="false" android:textColor="@color/laundry_primary" />
                </LinearLayout>

                <LinearLayout android:id="@+id/staffJobsEmptyState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:gravity="center" android:orientation="vertical" android:padding="18dp" android:visibility="gone">
                    <TextView android:id="@+id/staffJobsEmptyTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/staff_jobs_empty_title" android:textColor="@color/laundry_text_primary" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:id="@+id/staffJobsEmptyDescription" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="@string/staff_jobs_empty_description" android:textColor="@color/laundry_text_secondary" android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/staffJobsList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/staffJobsBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/staffJobsNavHome" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" app:srcCompat="@drawable/ic_home" app:tint="@color/dashboard_nav_inactive" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_home" />
        </LinearLayout>
        <LinearLayout android:id="@+id/staffJobsNavJobs" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/staff_nav_jobs" app:srcCompat="@drawable/ic_orders" app:tint="@color/laundry_primary" />
            <TextView style="@style/DashboardNavLabel.Active" android:text="@string/staff_nav_jobs" />
        </LinearLayout>
        <LinearLayout android:id="@+id/staffJobsNavHistory" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_history" app:srcCompat="@drawable/ic_history" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_history" />
        </LinearLayout>
        <LinearLayout android:id="@+id/staffJobsNavProfile" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" app:srcCompat="@drawable/ic_profile_nav" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
