<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/owner_background"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:id="@+id/profileHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/profileBackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/profile_back_description"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/profile_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/profileBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <FrameLayout
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:background="@drawable/bg_dashboard_profile"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_description"
                            android:src="@drawable/ic_person" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/profileHeaderName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="13dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/profile_name"
                        android:textColor="@color/laundry_text_primary"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/profile_account_information" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:orientation="vertical">
                        <TextView style="@style/ProfileInfoLabel" android:text="@string/profile_name_label" />
                        <TextView android:id="@+id/profileNameValue" style="@style/ProfileInfoValue" android:text="@string/profile_name" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:orientation="vertical">
                        <TextView style="@style/ProfileInfoLabel" android:text="@string/profile_username_label" />
                        <TextView android:id="@+id/profileUsernameValue" style="@style/ProfileInfoValue" android:text="@string/profile_username_value" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="66dp" android:gravity="center_vertical" android:orientation="vertical">
                        <TextView style="@style/ProfileInfoLabel" android:text="@string/profile_phone_label" />
                        <TextView android:id="@+id/profilePhoneValue" style="@style/ProfileInfoValue" android:text="@string/profile_phone_value" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/profile_menu_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/ProfileCard"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:id="@+id/profileEditMenu"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout style="@style/ProfileMenuIconFrame">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/profile_edit" android:src="@drawable/ic_profile_edit" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ProfileMenuTitle" android:text="@string/profile_edit" />
                            <TextView style="@style/ProfileMenuDescription" android:text="@string/profile_edit_description" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />

                    <LinearLayout
                        android:id="@+id/profilePasswordMenu"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout style="@style/ProfileMenuIconFrame">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/profile_change_password" android:src="@drawable/ic_profile_lock" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ProfileMenuTitle" android:text="@string/profile_change_password" />
                            <TextView style="@style/ProfileMenuDescription" android:text="@string/profile_change_password_description" />
                        </LinearLayout>
                        <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_chevron_right" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/dashboard_divider" />

                    <LinearLayout
                        android:id="@+id/profileLogoutMenu"
                        android:layout_width="match_parent"
                        android:layout_height="76dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_profile_logout_icon"
                            android:padding="9dp">
                            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="@string/profile_logout" android:src="@drawable/ic_profile_logout" />
                        </FrameLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/ProfileMenuTitle" android:text="@string/profile_logout" android:textColor="@color/profile_logout" />
                            <TextView style="@style/ProfileMenuDescription" android:text="@string/profile_logout_description" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/profileBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/profileNavHome"
            style="@style/DashboardNavItem">
            <ImageView
                style="@style/DashboardNavIcon"
                android:contentDescription="@string/nav_home"
                app:srcCompat="@drawable/ic_home"
                app:tint="@color/dashboard_nav_inactive" />
            <TextView
                style="@style/DashboardNavLabel"
                android:text="@string/nav_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileNavSecond"
            style="@style/DashboardNavItem">
            <ImageView
                android:id="@+id/profileNavSecondIcon"
                style="@style/DashboardNavIcon"
                android:contentDescription="@string/nav_orders"
                app:srcCompat="@drawable/ic_orders" />
            <TextView
                android:id="@+id/profileNavSecondLabel"
                style="@style/DashboardNavLabel"
                android:text="@string/nav_orders" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileNavThird"
            style="@style/DashboardNavItem">
            <ImageView
                android:id="@+id/profileNavThirdIcon"
                style="@style/DashboardNavIcon"
                android:contentDescription="@string/nav_history"
                app:srcCompat="@drawable/ic_history" />
            <TextView
                android:id="@+id/profileNavThirdLabel"
                style="@style/DashboardNavLabel"
                android:text="@string/nav_history" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/profileNavProfile"
            style="@style/DashboardNavItem">
            <ImageView
                style="@style/DashboardNavIcon"
                android:contentDescription="@string/nav_profile"
                app:srcCompat="@drawable/ic_profile_nav"
                app:tint="@color/laundry_primary" />
            <TextView
                style="@style/DashboardNavLabel.Active"
                android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
