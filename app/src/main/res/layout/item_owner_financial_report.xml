<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/ownerFinancialCode" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif-medium" android:textColor="@color/laundry_text_primary" android:textSize="14sp" android:textStyle="bold" tools:text="#LDY001" />
        <TextView android:id="@+id/ownerFinancialAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/laundry_primary_dark" android:textSize="15sp" android:textStyle="bold" tools:text="Rp45.000" />
    </LinearLayout>
    <TextView android:id="@+id/ownerFinancialCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/laundry_text_primary" android:textSize="14sp" tools:text="Nama pelanggan" />
    <TextView android:id="@+id/ownerFinancialMethod" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/laundry_text_secondary" android:textSize="12sp" tools:text="Cash" />
    <TextView android:id="@+id/ownerFinancialDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="@color/laundry_text_secondary" android:textSize="12sp" tools:text="26 Agustus 2026, 14:30" />
</LinearLayout>
