<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cashierDashboardTransactionCode"
            style="@style/DashboardOrderCode"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cashierDashboardTransactionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/laundry_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cashierDashboardTransactionCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/laundry_text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/cashierDashboardTransactionDetail"
        style="@style/DashboardOrderDetail" />

    <TextView
        android:id="@+id/cashierDashboardTransactionTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/laundry_text_primary"
        android:textSize="13sp" />
</LinearLayout>
