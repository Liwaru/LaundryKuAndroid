<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".DashboardCustomerActivity">

    <LinearLayout
        android:id="@+id/dashboardHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_dashboard_brand_logo"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/laundry_logo_description"
                    android:src="@drawable/ic_laundry_white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/app_name"
                android:textColor="@color/laundry_text_primary"
                android:textSize="21sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/customerGreetingText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/customer_greeting"
                android:textColor="@color/laundry_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_dashboard_profile"
                android:padding="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_description"
                    android:src="@drawable/ic_person" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dashboardHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/DashboardSectionTitle"
                android:text="@string/active_order_title" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/laundry_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="@color/dashboard_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/active_order_code"
                                android:textColor="@color/laundry_text_secondary"
                                android:textSize="13sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/active_order_service"
                                android:textColor="@color/laundry_text_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_active"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="11dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="11dp"
                            android:paddingBottom="7dp"
                            android:text="@string/active_order_status"
                            android:textColor="@color/dashboard_warning"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="@color/dashboard_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/active_order_estimate_label"
                                android:textColor="@color/laundry_text_secondary"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/active_order_estimate"
                                android:textColor="@color/laundry_text_primary"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/detailButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:minWidth="0dp"
                            android:text="@string/detail_order"
                            android:textAllCaps="false"
                            android:textColor="@color/laundry_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/laundry_primary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/newOrderButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/new_order_cta"
                android:textAllCaps="false"
                android:textColor="@color/laundry_on_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/laundry_primary"
                app:cornerRadius="14dp"
                app:elevation="0dp" />

            <TextView
                style="@style/DashboardSectionTitle"
                android:layout_marginTop="26dp"
                android:text="@string/popular_services" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/serviceDry"
                    style="@style/DashboardServiceCard"
                    android:layout_marginEnd="6dp">

                    <LinearLayout style="@style/DashboardServiceContent">
                        <FrameLayout style="@style/DashboardServiceIcon">
                            <ImageView
                                style="@style/DashboardServiceImage"
                                android:contentDescription="@string/service_dry"
                                app:srcCompat="@drawable/ic_service_wash" />
                        </FrameLayout>
                        <TextView android:id="@+id/serviceDryName" style="@style/DashboardServiceLabel" android:text="@string/service_dry" />
                        <TextView android:id="@+id/serviceDryPrice" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_price_fallback_dry" />
                        <TextView android:id="@+id/serviceDryMinimum" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_minimum_fallback_kg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/serviceIron"
                    style="@style/DashboardServiceCard"
                    android:layout_marginStart="6dp">

                    <LinearLayout style="@style/DashboardServiceContent">
                        <FrameLayout style="@style/DashboardServiceIcon">
                            <ImageView
                                style="@style/DashboardServiceImage"
                                android:contentDescription="@string/service_iron"
                                app:srcCompat="@drawable/ic_service_iron" />
                        </FrameLayout>
                        <TextView android:id="@+id/serviceIronName" style="@style/DashboardServiceLabel" android:text="@string/service_iron" />
                        <TextView android:id="@+id/serviceIronPrice" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_price_fallback_iron" />
                        <TextView android:id="@+id/serviceIronMinimum" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_minimum_fallback_kg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/serviceExpress"
                    style="@style/DashboardServiceCard"
                    android:layout_marginEnd="6dp">

                    <LinearLayout style="@style/DashboardServiceContent">
                        <FrameLayout style="@style/DashboardServiceIcon">
                            <ImageView
                                style="@style/DashboardServiceImage"
                                android:contentDescription="@string/service_express"
                                app:srcCompat="@drawable/ic_service_express" />
                        </FrameLayout>
                        <TextView android:id="@+id/serviceExpressName" style="@style/DashboardServiceLabel" android:text="@string/service_express" />
                        <TextView android:id="@+id/serviceExpressPrice" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_price_fallback_express" />
                        <TextView android:id="@+id/serviceExpressMinimum" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_minimum_fallback_kg" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/serviceBedCover"
                    style="@style/DashboardServiceCard"
                    android:layout_marginStart="6dp">

                    <LinearLayout style="@style/DashboardServiceContent">
                        <FrameLayout style="@style/DashboardServiceIcon">
                            <ImageView
                                style="@style/DashboardServiceImage"
                                android:contentDescription="@string/service_bed_cover"
                                app:srcCompat="@drawable/ic_service_bedcover" />
                        </FrameLayout>
                        <TextView android:id="@+id/serviceBedCoverName" style="@style/DashboardServiceLabel" android:text="@string/service_bed_cover" />
                        <TextView android:id="@+id/serviceBedCoverPrice" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_price_fallback_bedcover" />
                        <TextView android:id="@+id/serviceBedCoverMinimum" style="@style/DashboardServiceMeta" android:text="@string/dashboard_service_minimum_fallback_pcs" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/DashboardSectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/last_orders" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="@string/see_all"
                    android:textColor="@color/laundry_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/laundry_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/dashboard_divider"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_last_order_one" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="@color/dashboard_divider" />

                    <include layout="@layout/item_last_order_two" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_promo"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/promo_title"
                    android:textColor="@color/laundry_on_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/promo_subtitle"
                    android:textColor="@color/laundry_hero_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" android:src="@drawable/ic_home" />
            <TextView style="@style/DashboardNavLabel.Active" android:text="@string/nav_home" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navOrders" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_orders" android:src="@drawable/ic_orders" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_orders" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navHistory" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_history" android:src="@drawable/ic_history" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_history" />
        </LinearLayout>

        <LinearLayout android:id="@+id/navProfile" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" android:src="@drawable/ic_profile_nav" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
