<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customerOrdersRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background"
    tools:context=".CustomerOrdersActivity">

    <LinearLayout
        android:id="@+id/customerOrdersHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/customer_orders_title"
            android:textColor="@color/laundry_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/customerOrdersScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/customerOrdersBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/customerOrdersHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_order_filter_container"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/customerOrdersFilterAll"
                    style="@style/CustomerOrderFilterTab.Active"
                    android:text="@string/customer_orders_filter_all" />

                <TextView
                    android:id="@+id/customerOrdersFilterProcessing"
                    style="@style/CustomerOrderFilterTab"
                    android:text="@string/customer_orders_filter_process" />

                <TextView
                    android:id="@+id/customerOrdersFilterReady"
                    style="@style/CustomerOrderFilterTab"
                    android:text="@string/customer_orders_filter_ready" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/customerOrdersLoading"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="28dp"
                android:indeterminateTint="@color/laundry_primary" />

            <LinearLayout
                android:id="@+id/customerOrdersErrorState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/customer_orders_load_error"
                    android:textColor="@color/laundry_text_secondary"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/customerOrdersRetryButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/create_order_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/laundry_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/customerOrdersEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/customerOrdersEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/customer_orders_empty_title"
                    android:textColor="@color/laundry_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/customerOrdersEmptyDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:text="@string/customer_orders_empty_description"
                    android:textColor="@color/laundry_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/customerOrdersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/customerCreateOrderButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/customer_create_new_order"
                android:textAllCaps="false"
                android:textColor="@color/laundry_on_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/laundry_primary"
                app:cornerRadius="14dp"
                app:elevation="0dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/customerOrdersBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/laundry_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout android:id="@+id/customerOrdersNavHome" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_home" app:srcCompat="@drawable/ic_home" app:tint="@color/dashboard_nav_inactive" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_home" />
        </LinearLayout>

        <LinearLayout android:id="@+id/customerOrdersNavOrders" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_orders" app:srcCompat="@drawable/ic_orders" app:tint="@color/laundry_primary" />
            <TextView style="@style/DashboardNavLabel.Active" android:text="@string/nav_orders" />
        </LinearLayout>

        <LinearLayout android:id="@+id/customerOrdersNavHistory" style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_history" app:srcCompat="@drawable/ic_history" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_history" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/customerOrdersNavProfile"
            style="@style/DashboardNavItem">
            <ImageView style="@style/DashboardNavIcon" android:contentDescription="@string/nav_profile" app:srcCompat="@drawable/ic_profile_nav" />
            <TextView style="@style/DashboardNavLabel" android:text="@string/nav_profile" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
